{
  "name": "@every-qrcode/react",
  "version": "0.1.2",
  "private": false,
  "description": "React QR code generator with deterministic 3D Tree and Terrain effects powered by WebGPU.",
  "keywords": [
    "3d",
    "qr-code",
    "qr-code-component",
    "qr-code-generator",
    "qrcode",
    "qrcode-generator",
    "react",
    "react-component",
    "react-qr-code",
    "react-qrcode",
    "webgpu"
  ],
  "homepage": "https://github.com/AlbertAZ1992/every-qrcode#readme",
  "bugs": {
    "url": "https://github.com/AlbertAZ1992/every-qrcode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertAZ1992/every-qrcode.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
